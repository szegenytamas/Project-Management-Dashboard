# Copy this file to `.env` and adjust. `.env` is git-ignored; this file is not,
# so it must only ever contain placeholder values, never real secrets.

ENVIRONMENT=local
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000

# Local Postgres in Docker Compose (published on localhost:5433).
POSTGRES_USER=dashboard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dashboard
POSTGRES_PORT=5433
