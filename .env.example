# Copy this file to `.env` and adjust. `.env` is git-ignored; this file is not,
# so it must only ever contain placeholder / local-only values, never real secrets.
#
# Both the app (pydantic-settings) and Docker Compose read `.env`.

ENVIRONMENT=local
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000

# Local Postgres from Docker Compose. It is published on localhost:5433
# because 5432 is often used by a natively installed PostgreSQL.
# Tests automatically use a separate database named "<POSTGRES_DB>_test".
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=dashboard
POSTGRES_PASSWORD=dashboard
POSTGRES_DB=dashboard

# Signs the login tokens (JWT). At least 32 characters. Replace this value with
# your own random key:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=local-dev-only-insecure-key-replace-me-0123456789
JWT_EXPIRE_MINUTES=60

# Document storage: the local S3 emulator from Docker Compose (localhost:5000).
# The keys are dummies - the emulator accepts anything. In AWS leave all of
# these out: the real endpoint and the server's IAM role are used instead.
S3_BUCKET=project-dashboard-documents
S3_ENDPOINT_URL=http://localhost:5000
S3_CREATE_BUCKET=true
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=local-dev
AWS_SECRET_ACCESS_KEY=local-dev

# Limits (bytes)
MAX_FILE_SIZE_BYTES=10485760
PROJECT_SIZE_LIMIT_BYTES=52428800
