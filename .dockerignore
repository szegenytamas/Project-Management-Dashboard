# fast and, more importantly, keeps secrets (.env) out of images.
.git
.github
.venv
.tox
.mypy_cache
.pytest_cache
.ruff_cache
**/__pycache__
.coverage
coverage.xml
htmlcov
dist
build
storage
tests
.env
.env.*
*.md
!README.md
