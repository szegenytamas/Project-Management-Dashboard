# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# --- Virtual environments (uv creates .venv) ---
.venv/
venv/

# --- Tooling caches ---
.tox/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# --- Secrets / local config: NEVER commit real values ---
.env
.env.*
!.env.example

# --- Local scratch storage in the repo root ---
# The leading "/" anchors the pattern to the root. Without it, "storage/"
# also matched src/project_dashboard/storage/ (the S3 client package).
/storage/

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# --- AWS Lambda build artifacts ---
lambda/**/package/
*.zip
